DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=1
# Host names the site is served from, comma separated. Bare hosts only; a pasted
# URL such as https://school.example.com/ is normalised automatically.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=school_management
POSTGRES_USER=school_management
POSTGRES_PASSWORD=school_management
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Set to 1 to force SQLite even when POSTGRES_HOST is set.
# DJANGO_USE_SQLITE=0

# Email. The default prints messages to the server console instead of sending them.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=School Management <no-reply@school-management.test>
# Where the support form delivers. Leave empty to use DEFAULT_FROM_EMAIL.
SUPPORT_EMAIL=

# Celery. Notifications are queued here. Leave the broker empty in development
# and the tasks run inline; set it to a Redis URL in production.
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# CELERY_TASK_ALWAYS_EAGER=1

# Security. These turn on automatically when DJANGO_DEBUG is off. Only override
# them if you need to adjust the behaviour.
# DJANGO_SECURE_SSL_REDIRECT=1
# DJANGO_SESSION_COOKIE_SECURE=1
# DJANGO_CSRF_COOKIE_SECURE=1
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=1
# DJANGO_SECURE_HSTS_PRELOAD=0
# DJANGO_CSRF_TRUSTED_ORIGINS=https://school.example.com
